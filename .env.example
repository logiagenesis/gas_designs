# =============================================================================
# GAS DESIGNS — ENVIRONMENT
#
# Copy to `.env.local` for development. Never commit a filled-in copy.
# The site builds and runs correctly with every optional value left blank.
# =============================================================================

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.gasdesigns.co.za

# --- Analytics and advertising (all optional) ---------------------------
# Each tag loads ONLY if its variable is set. Leave blank to ship no tags.
# If GTM is set it takes precedence and GA4 is not loaded directly.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Contact form delivery (server-side only) ---------------------------
# Google Workspace over SMTP. Do not add Google API credentials.
# SMTP_PASS must be an app password, not the account password.
CONTACT_TO_EMAIL=pierre@gasdesigns.co.za
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Public business details --------------------------------------------
# Email is confirmed and is published on the site.
NEXT_PUBLIC_BUSINESS_EMAIL=pierre@gasdesigns.co.za

# The phone, WhatsApp and Maps values below are intentionally EMPTY.
# The candidate phone number is currently shared with DP Energies and must not
# be published until Pierre confirms ownership and exclusive use. See
# docs/missing-client-info.md before filling any of these in.
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_GOOGLE_MAPS_URL=
